# ============================================================
# E-commerce Microservice — Environment Variables Template
# Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# --- SQL Server ---
SA_PASSWORD=change-me-sa-password

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB_PRODUCT=ProductDb
POSTGRES_DB_CUSTOMER=CustomerDb

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password

# --- RabbitMQ ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- Elasticsearch ---
ELASTIC_PASSWORD=change-me-elastic-password

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-key-min-32-characters-long
JWT_ISSUER=http://identity-api:80
JWT_AUDIENCE=microservices_api
JWT_EXPIRATION_MINUTES=30

# --- SMTP (Gmail App Password) ---
SMTP_USERNAME=
SMTP_PASSWORD=change-me-gmail-app-password

# --- IdentityServer ---
IDP_POSTMAN_CLIENT_SECRET=change-me-idp-postman-client-secret

# --- External APIs ---
SENDINBLUE_API_KEY=change-me-sendinblue-api-key
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
